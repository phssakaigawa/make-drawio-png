  <diagram id="how-it-works-ja" name="make-drawio-png の仕組み">
    <mxGraphModel dx="1400" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="420" math="0" shadow="1">
      <root>
